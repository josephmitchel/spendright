# PostgreSQL 11 or newer (checked at startup).
DATABASE_URL=postgresql://user@localhost:5432/spendright
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# 32-byte hex key for AES-256-GCM encryption of Plaid access tokens.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=64_hex_characters
# To rotate: move the old key here, set a fresh ENCRYPTION_KEY, run
# `npm run rotate:key`, then remove this line.
# ENCRYPTION_KEY_PREVIOUS=64_hex_characters
