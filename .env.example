DATABASE_URL=postgresql://user@localhost:5432/spendright
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# 32-byte hex key for AES-256-GCM encryption of Plaid access tokens.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=64_hex_characters
# Public http(s) URL for POST /api/webhook (enables automatic sync via Plaid
# transaction webhooks; on localhost this means a tunnel). Leave unset to
# disable webhooks — syncing is then manual ("Sync all") only.
# After setting or changing it, push it to existing items: npm run webhooks:update
# PLAID_WEBHOOK_URL=https://your-tunnel.example.com/api/webhook
