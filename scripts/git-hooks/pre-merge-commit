#!/bin/sh
# Blocks merging into main unless the incoming branch updated the snapshot.
# The staged index holds the merge result at this point (MERGE_HEAD is not
# written for auto-committed merges), so compare it against HEAD.
# Limitation: this hook only fires on real merge commits — fast-forward
# merges skip it, so merge into main with --no-ff for the gate to apply.

branch=$(git symbolic-ref --short -q HEAD)
[ "$branch" = "main" ] || exit 0

if git diff --cached --quiet HEAD -- .claude/snapshot/SNAPSHOT.md; then
  echo "pre-merge-commit: blocked — this merge into main brings no update to .claude/snapshot/SNAPSHOT.md." >&2
  echo "Run /snapshot on the branch first so the snapshot rides in with the merge." >&2
  exit 1
fi
