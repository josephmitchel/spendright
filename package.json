{
  "name": "spendright",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/tighten-next.mjs",
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "node scripts/tighten-next.mjs",
    "build": "next build",
    "postbuild": "node scripts/tighten-next.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint && node scripts/check-design-refs.mjs && node scripts/check-record-tags.mjs && node scripts/check-verified-claims.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:cards": "tsx scripts/seed-cards.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "plaid": "^41.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-plaid-link": "^4.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
